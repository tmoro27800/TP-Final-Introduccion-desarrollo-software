# Copiá este archivo a ".env" (mismo directorio) y completá con los datos
# de TU Postgres local. ".env" está en .gitignore a propósito: cada
# integrante del equipo tiene su propio usuario/contraseña de Postgres,
# por eso nunca se sube al repo.
#
#   cp .env.example .env
#
# Si no ponés nada, pool.js (src/db/pool.js) usa estos valores por
# default: host localhost, puerto 5432, user postgres, password postgres,
# database puzzle_game. Si tu instalación de Postgres tiene otro usuario
# o contraseña, el backend va a fallar con:
#   "password authentication failed for user postgres"
# hasta que completes estas variables con tus datos reales.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=puzzle_game
